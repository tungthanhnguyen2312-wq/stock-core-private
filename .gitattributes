* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.parquet binary
*.db binary

# Retained provider/documentation bytes are hash-bound evidence, never source text.
operations-review/**/raw/* -text
operations-review/**/official-documentation/* -text
