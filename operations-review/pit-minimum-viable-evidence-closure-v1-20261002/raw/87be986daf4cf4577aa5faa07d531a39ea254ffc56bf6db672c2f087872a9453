    <script>
        $(function () {
            $(".btn-menu-expand").on("click", function (e) {
                $(".menu-left-popup").toggle("slide", { direction: "left" }, 200);
            });

            $(document).on("click", function (e) {
                var container = $('.menu-container'), popupmenu = $('.menu-left-popup');

                if (container.has(e.target).length <= 0 && popupmenu.is(e.target)) {
                    $(".menu-left-popup").toggle("slide", { direction: "left" }, 200);
                }
            });

            $(".am-clicksubmenu").on("click", function (e) {
                if ($(this).parent().hasClass("active")) {
                    $(".menu-left li.active").removeClass("active");
                }
                else {
                    $(".menu-left li.active").removeClass("active");
                    $(this).parent().addClass("active");
                }
            });

            $('#txtGStockSearch').on("keypress", function (e) {
                e = window.event || e;
                if (e.keyCode == 13) {
                    var _stock_code = this.value.trim();
                    if (_stock_code != "") {
                        window.location.href = "/m-tim-kiem-" + _stock_code + ".html";
                    }
                    else {
                        this.value = "";
                    }
                }
            });

            $("#btnGStockSearch").on("click", function () {
                var _stock_code = $('#txtGStockSearch').val().trim();
                if (_stock_code != "") {
                    window.location.href = "/m-tim-kiem-" + _stock_code + ".html";
                }
                else {
                    $('#txtGStockSearch').val("");
                }
            });


            $.ajax({
                url: '/Home/MobileSearchAutocompleteStockCode',
                type: 'POST',
                data: {},
                sync: false, cache: false, traditional: true,
                success: function (data) {
                    var lts = data.lst;
                    $('#txtGStockSearch').autocomplete({
                        autoFocus: true,
                        source: function (request, response) {
                            var matcher = new RegExp("" + $.ui.autocomplete.escapeRegex(request.term.toUpperCase()), "i");
                            response($.grep(lts, function (item) {
                                return matcher.test(item.STOCK_CODE);
                            }));
                        },
                        select: function (event, ui) {
                          
                                window.location.href = "/m-tim-kiem-" + ui.item.STOCK_CODE + ".html";
                           
                           
                        },
                        focus: function (event, ui) {
                            //this.value = ui.item.STOCK_CODE;
                            var arrResult = $("ul .ui-corner-all");
                            for (var i = 0; i < arrResult.length; i++) {
                                var label = $.trim($(arrResult[i]).text().split("-")[0]);
                                if (label == ui.item.STOCK_CODE) {
                                    $(".clsLiActive").removeClass("clsLiActive")
                                    $(arrResult[i]).addClass("clsLiActive");
                                    break;
                                }
                            }
                            event.preventDefault();
                        },
                        open: function (event, ui) {
                            $("ul").scrollTop(0);
                            event.preventDefault();
                        },
                    });
                }
            });

            $.ui.autocomplete.prototype._renderItem = function (ul, item) {


                

                var re = new RegExp("" + this.term.toUpperCase());


                if (item.MARKETCODE == "CB") {
                    var t = ("<label style=\"color: red;\">" + item.STOCK_CODE + "</label> ");
                }else{
                    var t = ("<label style=\"color: red;\">" + item.STOCK_CODE + "</label> - " + item.NAME );
                }

                
                t = t.replace(re, "<b>" + this.term.toUpperCase() + "</b></span>");

                return $("<li></li>")
                        .data("item.autocomplete", item)
                        .append("<a>" + t + "</a>")
                        .appendTo(ul);
            };
        });

    </script>


